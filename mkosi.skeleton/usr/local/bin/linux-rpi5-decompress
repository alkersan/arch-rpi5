#!/usr/bin/env bash
set -euo pipefail

shopt -s nullglob

sources=()

# Find the installed linux-rpi5 kernel.
for pkgfile in /usr/lib/modules/*/pkgbase; do
    [[ -r "$pkgfile" ]] || continue

    if [[ "$(<"$pkgfile")" == "linux-rpi5" ]]; then
        sources+=("${pkgfile%/pkgbase}/vmlinuz")
    fi
done

# Do not select an arbitrary kernel if multiple versions exist.
if (( ${#sources[@]} != 1 )); then
    echo "Expected one linux-rpi5 kernel, found ${#sources[@]}" >&2
    exit 1
fi

src="${sources[0]}"
mv "$src" "$src.gz"
gzip -d "$src.gz"
